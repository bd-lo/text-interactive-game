# textgame 环境变量示例（开发文档第 16 章 16.5 环境变量表 + LLM 接入第 12 章）
# 用法：复制为 .env 后按需修改；.env 不入库，禁止在此写入任何真实密钥。
# 真实 API Key 只写进 .env（已被 .gitignore 忽略），本文件只保留占位说明。

# SQLite 数据库连接串；测试使用内存 SQLite，不得指向生产库
TEXTGAME_DB_URL=sqlite:///data/textgame.db

# 固定种子回放（Replay）的默认值；测试用例必须显式传 seed
TEXTGAME_SEED=42

# DeepSeek 接入（第 12 章）：供应商 / 模型 / 兼容端点
# M5-020（D-M5-4）起：模型分级（tiers）与缓存参数由 JSON 配置权威决定
# （包内 llm/config/llm.default.json，可用 TEXTGAME_LLM_CONFIG 覆盖路径）；
# 以下三项保留为 019 单模型兼容回退字段，`tiers` 缺省时才会使用。
TEXTGAME_LLM_PROVIDER=deepseek
TEXTGAME_LLM_MODEL=deepseek-flash
TEXTGAME_LLM_BASE_URL=https://api.deepseek.com

# M5-020（D-M5-4）：本地模型分级/缓存 JSON 路径覆盖（缺省用包内默认 llm.default.json）
# TEXTGAME_LLM_CONFIG=

# 真实 LLM 开关（D-M5-6 / 2026-11-11 运行期凭据 D-LLM-1）：
# - 缺省（不设置）：按「有 key 就自动启用」判定——本机 .env 有 TEXTGAME_LLM_API_KEY 即默认使用开发 key；
# - false：显式关闭，永远离线（忽略任何 key，确定性路径）；自检/演示/e2e 也强制走这条；
# - true：显式要求启用（无 key 时降级为离线并在状态接口如实提示，不阻止启动；
#   构造期 fail-fast 仅存在于历史工厂路径 llm/factory.py，生产组合根已改用 RuntimeLLMClient）。
# TEXTGAME_LLM_ENABLED=

# API Key（只从环境注入；真实值写在 .env，本文件不要写真实密钥）。
# 本机开发：填这里即可默认启用（无需再设 TEXTGAME_LLM_ENABLED=true）。
# 干净克隆/玩家机器：不填也行——保持离线可玩，玩家可在网页「设置」页输入自己的 key
# （保存在 data/llm.credentials.json，已 gitignore；或用下面的路径覆盖）。
# TEXTGAME_LLM_API_KEY=<在 .env 中填入 DeepSeek API Key>

# 玩家输入的本机凭据文件路径覆盖（缺省 data/llm.credentials.json；网页设置页写入）
# TEXTGAME_LLM_CREDENTIALS_FILE=

# 日志级别（stdlib logging；Event 必须落盘，不依赖日志）
TEXTGAME_LOG_LEVEL=INFO

# 流式叙事后端（N2-038 / ADR D-N2-8）：POST /api/v1/turns/stream（NDJSON 5 事件）开关。
# - true（默认）：端点在存在但旧客户端不调用（死代码无副作用）；网页前端 039 起只在
#   「LLM 已配置」时使用流式，离线/模板叙事仍走普通 /turns（逐字不变）。
# - false：端点返回 404 统一失败信封，前端自动降级普通 /turns——出问题时可一键回滚。
# 该开关不影响旧 POST /turns、旧 golden、demo/console --check 与默认离线路径。
# TEXTGAME_STREAM_ENABLED=true

# 启动器（普通玩家双击 启动游戏.bat / python -m textgame.launcher）相关：
# 控制面 /api/v1/app/status|heartbeat|shutdown 是否可用由启动器进程注入的 LauncherController
# 决定（`python -m textgame.launcher` 才启用；普通 `uvicorn textgame.main:app` 不启用），
# 没有 env 开关，玩家无需手动设置。
#
# - TEXTGAME_IDLE_EXIT_SECONDS：空闲自动退出秒数（默认 300 = 关掉浏览器 5 分钟后自动退出；
#   0 = 关闭自动退出）。启动器 CLI `--idle-exit-seconds` 优先于本变量；从未收到网页心跳不判空闲。
# TEXTGAME_IDLE_EXIT_SECONDS=300

# 自由制造（默认关闭）：不命中固定配方时调用大模型生成一次草稿（进入裁决前）。
# R-19（2026-11）：草稿由编排层 pre-queue 生成一次，Resolver/CAS 重试纯执行、不重调模型；
# 生成或校验失败时零写入。
# 推荐玩家在网页「设置 → 自由制造」开启：前端二次确认等价于运行期 opt-in，
# 偏好持久化到 data/free_craft.json，重启保留（该文件优先于下面的 env 默认值）。
# 以下 env 仅用于无头/生产初始默认；TEXTGAME_ALLOW_RESOLVER_LLM 保留为历史兼容的
# 显式二次确认（原「Resolver 内调 LLM」风险已消除，M5 后评估是否简化），显式开启时仍要求：
# TEXTGAME_FREE_CRAFT_ENABLED=false
# TEXTGAME_ALLOW_RESOLVER_LLM=false
# 偏好文件路径覆盖（默认 data/free_craft.json；留空 = 用默认路径）：
# TEXTGAME_FREE_CRAFT_SETTINGS_FILE=

# 局域网/反代安全：
# - 默认只允许 127.0.0.1/localhost/[::1]/testserver 的 Host 头；
#   通过局域网 IP 访问时把实际 Host 加入白名单（逗号分隔）。
# TEXTGAME_ALLOWED_HOSTS=127.0.0.1,localhost,[::1],testserver
# - 非 loopback 客户端必须携带 Authorization: Bearer <token> 或 X-API-Token；
#   不设置时非本机访问一律 403（默认部署只适合 127.0.0.1）。
# TEXTGAME_API_TOKEN=
# - 同机反代信任（R-25，默认 false）：本机反代（nginx/caddy 等）把外部请求转到 127.0.0.1
#   时必须显式设 true，服务端才按 X-Forwarded-For/Forwarded 的**首跳**判定客户端来源；
#   未启用时任何带代理头的请求一律 403（防止伪造 XFF 冒充本机绕过 token 校验）。
#   启用前提：反代必须**覆写**（而不是透传客户端自带的）X-Forwarded-For；多值只信第一个。
# TEXTGAME_TRUST_PROXY=false

# 进程模型（R-04/R-05）：本项目只支持单进程部署（进程内锁、启动期自动迁移互斥、
# 运行期凭据热切换都假设单进程）。检测到 WEB_CONCURRENCY / UVICORN_WORKERS /
# GUNICORN_WORKERS > 1 时启动即报错；确有多 worker 需求才显式接受风险。
# TEXTGAME_ALLOW_MULTI_WORKER=false
