# textgame 环境变量示例（开发文档第 16 章 16.5 环境变量表 + LLM 接入第 12 章）
# 用法：复制为 .env 后按需修改；.env 不入库，禁止在此写入任何真实密钥。
# 真实 API Key 只写进 .env（已被 .gitignore 忽略），本文件只保留占位说明。

# SQLite 数据库连接串；测试使用内存 SQLite，不得指向生产库
TEXTGAME_DB_URL=sqlite:///data/textgame.db

# 固定种子回放（Replay）的默认值；测试用例必须显式传 seed
TEXTGAME_SEED=42

# DeepSeek 接入（第 12 章）：供应商 / 模型 / 兼容端点
TEXTGAME_LLM_PROVIDER=deepseek
TEXTGAME_LLM_MODEL=deepseek-flash
TEXTGAME_LLM_BASE_URL=https://api.deepseek.com

# API Key（只从环境注入；真实值写在 .env，本文件不要写真实密钥）
# TEXTGAME_LLM_API_KEY=<在 .env 中填入 DeepSeek API Key>

# 日志级别（structlog）；Event 必须落盘，不依赖日志
TEXTGAME_LOG_LEVEL=INFO
