{
  "schema_version": 1,
  "providers": {
    "deepseek": {
      "api_base": "https://api.deepseek.com"
    }
  },
  "tiers": {
    "strong": {
      "provider": "deepseek",
      "model": "deepseek-flash",
      "fallbacks": []
    },
    "economy": {
      "provider": "deepseek",
      "model": "deepseek-flash",
      "fallbacks": []
    }
  },
  "cache": {
    "maxsize": 1024,
    "ttl_s": 600,
    "allowed_tasks": []
  },
  "circuit": {
    "window_s": 60,
    "error_rate_threshold": 0.5,
    "consecutive_failures": 5,
    "open_s": 60,
    "half_open_probes": 1
  }
}
