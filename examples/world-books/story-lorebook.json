    "6": {
      "uid": 6,
      "key": [
        "规矩",
        "换班",
        "守夜",
        "路不封死"
      ],
      "keysecondary": [],
      "comment": "哨站的三条老规矩",
      "content": "哨站的老规矩只有三条：灯不灭、人不等、路不封死。灯不灭，是给河谷里的活人看；人不等，是不替迷路的人做决定；路不封死，是哪怕没有一个人来，也留一条能走的道。老兵照着这三条守了半辈子。",
      "constant": false,
      "vectorized": false,
      "selective": false,
      "selectiveLogic": 0,
