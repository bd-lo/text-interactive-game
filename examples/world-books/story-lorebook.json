    "5": {
      "uid": 5,
      "key": [
        "哨站历史",
        "旧哨所",
        "兵站",
        "三十年前"
      ],
      "keysecondary": [],
      "comment": "哨站历史",
      "content": "这哨站最早是兵站，管着河谷的封路与换防。三十年前那场大雪之后，兵撤了，只留下守夜的人。屋檐下的铁环还挂着旧马灯，门板上钉着已经锈死的铜牌，字迹被风磨得看不清。门口的石墩上还留着拴马的铁环，摸上去一手锈。",
      "constant": false,
      "vectorized": false,
      "selective": false,
      "selectiveLogic": 0,
