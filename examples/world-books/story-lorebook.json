    "1": {
      "uid": 1,
      "key": [
        "信号灯",
        "灯座",
        "灯芯",
        "点火"
      ],
      "keysecondary": [],
      "comment": "信号灯机制（常量）",
      "content": "信号灯立在不高的瞭望塔顶，灯座里垫着干草与松脂，灯芯要先用火石引着，再插一支浸过松脂的火把。灯一亮，河谷里看得见它的高度，雪线那头的人便能顺着光找到哨站。规矩是老辈定的：灯可以灭，人不能走。",
      "constant": true,
      "vectorized": false,
      "selective": false,
      "selectiveLogic": 0,
      "addMemo": true,
